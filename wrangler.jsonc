{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atlas-mailer",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-12",
	"kv_namespaces": [
		{
			"binding": "MAILER_KV",
			"id": "your-kv-namespace-id"
		}
	],
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
