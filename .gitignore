# .gitignore for Cloudflare Workers

# Environment Variables & Secrets
.dev.vars
.env
.env.local

# Build & Runtime
node_modules/
.wrangler/
dist/
*.log
# Ignore generated JavaScript outputs emitted next to TypeScript sources
src/**/*.js
src/**/*.js.map
dist/
build/

# TypeScript
tsconfig.tsbuildinfo

# OS Files
.DS_Store
Thumbs.db
